\newlabel{fig:ns-svensson}{{1}{3}{\textbf {Nelson-Siegel and Svensson fits to the US Treasury yield curve, most recent trading day.} Points are the Constant Maturity Treasury rates from FRED at ten maturities. Solid line: Nelson-Siegel, RMSE 4.5 basis points. Dashed: Svensson, RMSE 2.9 basis points. Maturity on a log scale}{figure.caption.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces \textbf  {Parameter estimates for Nelson-Siegel and Svensson fits on the most recent US Treasury curve.} Rates are in decimal units. The Nelson-Siegel level $\beta _0$ is the asymptotic long-run rate. The negative slope $\beta _1$ reflects the upward-sloping curve at the observation date. RMSE in basis points.}}{3}{table.caption.3}\protected@file@percent }
\newlabel{tab:params}{{1}{3}{\textbf {Parameter estimates for Nelson-Siegel and Svensson fits on the most recent US Treasury curve.} Rates are in decimal units. The Nelson-Siegel level $\beta _0$ is the asymptotic long-run rate. The negative slope $\beta _1$ reflects the upward-sloping curve at the observation date. RMSE in basis points}{table.caption.3}{}}
